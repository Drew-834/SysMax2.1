<Page x:Class="SysMax2._1.Pages.OptimizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SysMax2._1.Pages"
      mc:Ignorable="d" 
      Title="System Optimization"
      Background="#FF1E1E1E">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="85*"/>
            <ColumnDefinition Width="41*"/>
            <ColumnDefinition Width="44*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="20,20,20,20" Grid.ColumnSpan="3">

            <TextBlock Text="CPU Usage:" FontSize="14" FontWeight="Bold" Foreground="White"/>
            <ProgressBar x:Name="CpuUsageBar" Width="300" Height="20"/>
            <TextBlock x:Name="CpuUsageText" FontSize="12"/>

            <TextBlock Text="RAM Usage:" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,10,0,0"/>
            <ProgressBar x:Name="RamUsageBar" Width="300" Height="20"/>
            <TextBlock x:Name="RamUsageText" FontSize="12"/>

            <TextBlock Text="Startup Applications:" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,10,0,0"/>
            <ListBox x:Name="StartupList" Width="300" Height="100"/>
            <Button Content="Disable Selected Startup App" Click="DisableStartup_Click" Width="200" Margin="0,5,0,0"/>

            <TextBlock Text="Running Processes:" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,10,0,0"/>
            <ListBox x:Name="ProcessList" Width="300" Height="100"/>
            <Button Content="Kill Selected Process" Click="KillProcess_Click" Width="200" Margin="0,5,0,0"/>

            <TextBlock Text="Ping Test:" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,10,0,0"/>
            <TextBox x:Name="PingInput" Width="200" Height="25" Text="google.com"/>
            <Button Content="Check Ping" Click="CheckPing_Click" Width="100" Margin="0,5,0,0"/>
            <TextBlock x:Name="PingResultText" FontSize="12" Margin="0,5,0,0"/>

        </StackPanel>
    </Grid>
</Page>
