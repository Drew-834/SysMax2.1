<Page x:Class="SysMax2._1.Pages.DiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SysMax2._1.Pages"
      mc:Ignorable="d" 
        Title="System Diagnostics" Height="491" Width="1018" Background="#121212" Foreground="White">

    <Grid>
        <TextBlock Text="Diagnostics Page" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,0"/>

        <!-- CPU & RAM Information -->
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,60,0,0">
            <TextBlock Text="CPU Usage:" FontSize="16"/>
            <TextBlock x:Name="txtCpuUsage" FontSize="16" FontWeight="Bold"/>

            <TextBlock Text="RAM Available:" FontSize="16" Margin="0,10,0,0"/>
            <TextBlock x:Name="txtRamUsage" FontSize="16" FontWeight="Bold"/>
        </StackPanel>

        <!-- Network Information -->
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,160,0,0">
            <TextBlock Text="IP Address:" FontSize="16"/>
            <TextBlock x:Name="txtIpAddress" FontSize="16" FontWeight="Bold"/>

            <TextBlock Text="Network Ping:" FontSize="16" Margin="0,10,0,0"/>
            <TextBlock x:Name="txtPing" FontSize="16" FontWeight="Bold"/>
        </StackPanel>

        <!-- Hardware Temperatures -->
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,260,0,0">
            <TextBlock Text="CPU Temperature:" FontSize="16"/>
            <TextBlock x:Name="txtCpuTemp" FontSize="16" FontWeight="Bold"/>

            <TextBlock Text="GPU Temperature:" FontSize="16" Margin="0,10,0,0"/>
            <TextBlock x:Name="txtGpuTemp" FontSize="16" FontWeight="Bold"/>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,350,0,0">
            <Button Content="Clear Temp Files" Click="ClearTempFiles_Click" Margin="5"/>
            <Button Content="Restart Network" Click="RestartNetworkAdapter_Click" Margin="5"/>
            <Button Content="Run Diagnostics" Click="RunDiagnostics_Click" Margin="5"/>
        </StackPanel>
    </Grid>
</Page>
